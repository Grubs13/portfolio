---
import '@fontsource/jersey-15';
import '@fontsource-variable/overpass';
import LinkList from '../components/LinkList.astro';
import { scenes } from '../content/scenes';

const contactId = scenes.find((s) => s.kind === 'contact')?.id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Calen Gruber | Mechanical Engineer</title>
    <meta name="description" content="Calen Gruber, mechanical engineer: reliability and operations roles, projects and how to get in touch." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !(navigator.connection && navigator.connection.saveData) &&
        'WebGLRenderingContext' in window
      )
        document.documentElement.classList.add('world');
    </script>
  </head>
  <body>
    <canvas class="world-canvas" aria-hidden="true"></canvas>
    <header class="site-header">
      {contactId && <a class="skip-link" href={`#${contactId}`}>Skip to contact</a>}
      <a href="#">Résumé</a>
    </header>
    <main>
      {
        scenes.map((scene) => (
          <section id={scene.id} class={`scene scene-${scene.kind}`} aria-labelledby={`${scene.id}-heading`}>
            <div class="panel">
              {scene.kind === 'intro' && (
                <>
                  <h1 id={`${scene.id}-heading`}>{scene.name}</h1>
                  <p class="tagline">{scene.tagline}</p>
                </>
              )}
              {scene.kind === 'role' && (
                <>
                  <p class="eyebrow">Role</p>
                  <h2 id={`${scene.id}-heading`}>{scene.title}</h2>
                  <p class="meta">{scene.org}</p>
                  <ul>
                    {scene.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </>
              )}
              {scene.kind === 'project' && (
                <>
                  <p class="eyebrow">Project</p>
                  <h2 id={`${scene.id}-heading`}>{scene.title}</h2>
                  <p class="meta">{scene.org}</p>
                  <ul>
                    {scene.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                  {scene.links.length > 0 && <LinkList links={scene.links} />}
                </>
              )}
              {scene.kind === 'interest' && (
                <>
                  <p class="eyebrow">Interests</p>
                  <h2 id={`${scene.id}-heading`}>{scene.title}</h2>
                  <p>{scene.summary}</p>
                  <ul>
                    {scene.topics.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </>
              )}
              {scene.kind === 'contact' && (
                <>
                  <h2 id={`${scene.id}-heading`}>Contact</h2>
                  <p>
                    <a href={`mailto:${scene.email}`}>{scene.email}</a>
                  </p>
                  <LinkList links={scene.links} />
                </>
              )}
            </div>
          </section>
        ))
      }
    </main>
    <script>
      import '../world/boot';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --space-0: #05060f;
    --space-1: #0d1024;
    --star: #e8ebff;
    --dust: #a3a9cc;
    --nebula: #9d8cff;
    --nebula-bright: #c4b8ff;
    --gutter: max(16px, 4vw);
    --measure: 40rem;
    /* Pixel display face echoes the pixel-art world; Overpass descends from Highway Gothic, the lettering of road and plant signage. */
    --font-display: 'Jersey 15', system-ui, sans-serif;
    --font-body: 'Overpass Variable', system-ui, sans-serif;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: radial-gradient(ellipse at top, var(--space-1), var(--space-0) 70%) fixed var(--space-0);
    color: var(--star);
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.55;
    font-weight: 380;
    font-kerning: normal;
    font-variant-numeric: lining-nums;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
  }

  a {
    color: var(--nebula-bright);
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }

  a:hover {
    color: var(--star);
  }

  a:focus-visible {
    outline: 2px solid var(--nebula);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-header {
    display: flex;
    justify-content: flex-end;
    padding: 1rem var(--gutter);
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: 1rem;
    transform: translateY(-200%);
    background: var(--space-1);
    padding: 0.25rem 0.5rem;
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    padding-inline: var(--gutter);
  }

  .scene {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block: clamp(3rem, 12vh, 8rem);
    overflow-wrap: anywhere;
  }

  .scene + .scene {
    border-top: 1px solid color-mix(in srgb, var(--dust) 20%, transparent);
  }

  h1,
  h2 {
    font-family: var(--font-display);
    line-height: 1.05;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }

  /* The one loud moment: a hard, unblurred offset shadow, like a sprite's drop shadow. */
  h1 {
    font-size: clamp(3.75rem, 14vw, 7.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-shadow:
      0.06em 0.06em 0 color-mix(in srgb, var(--nebula) 55%, var(--space-0)),
      0.12em 0.12em 0 var(--space-0);
  }

  h2 {
    font-size: clamp(2.25rem, 6vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  p,
  li {
    text-wrap: pretty;
  }

  .tagline {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--dust);
  }

  .eyebrow {
    margin: 0 0 0.375rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--nebula);
  }

  .meta {
    margin-top: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--dust);
  }

  strong,
  .links a {
    font-weight: 600;
  }

  .site-header a {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .world-canvas {
    display: none;
  }

  .world {
    --panel: rgb(5 6 15 / 0.86);
    --world-focus-y: 0.27;
  }

  .world .world-canvas {
    display: block;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .world-ready .world-canvas {
    opacity: 1;
  }

  .world .site-header,
  .world main {
    position: relative;
  }

  .world .scene {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 1.5rem;
  }

  .world .scene + .scene {
    border-top: 0;
  }

  .world .panel {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--dust) 18%, transparent);
    border-radius: 12px;
    background: var(--panel);
  }

  @media (min-width: 900px) {
    .world {
      --world-beside: 1;
      --world-focus-y: 0.5;
    }

    .world .scene {
      justify-content: center;
      max-width: min(var(--measure), 46vw);
      margin-inline: 0;
    }

    /* Panels alternate sides down the page, so each scene's subject sits in the other half. */
    .world .scene:nth-child(even) {
      margin-inline-start: auto;
    }
  }

  /* The opening: the page's title alone over the dark, no card. */
  .scene-intro h1 {
    font-size: clamp(4.5rem, 16vw, 10rem);
  }

  .scene-intro .tagline {
    max-width: 34ch;
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
  }

  .world .scene-intro {
    justify-content: center;
  }

  .world .scene-intro .panel {
    padding: 0;
    border: 0;
    background: none;
  }

  /* Long cards stay in a phone's lower half: smaller text, tighter lists. */
  @media (max-width: 899px) {
    .scene:not(.scene-intro) .panel {
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .scene:not(.scene-intro) h2 {
      font-size: 2rem;
    }

    .panel ul {
      padding-left: 1.1rem;
    }

    .panel li + li {
      margin-top: 0.35rem;
    }
  }

  /* A game-UI plate like the HUD in the style references: square stepped pixel corners and a hard offset shadow. */
  .world .scene:not(.scene-intro) .panel {
    --step: 4px;
    border: 0;
    border-radius: 0;
    background: rgb(13 16 36 / 0.94);
    clip-path: polygon(
      0 var(--step), var(--step) var(--step), var(--step) 0,
      calc(100% - var(--step)) 0, calc(100% - var(--step)) var(--step), 100% var(--step),
      100% calc(100% - var(--step)), calc(100% - var(--step)) calc(100% - var(--step)), calc(100% - var(--step)) 100%,
      var(--step) 100%, var(--step) calc(100% - var(--step)), 0 calc(100% - var(--step))
    );
    box-shadow: inset 0 0 0 2px rgb(157 140 255 / 0.35);
  }

  /* On the section, since the plate's own clip would cut its shadow off. */
  .world .scene:not(.scene-intro) {
    filter: drop-shadow(6px 6px 0 rgb(5 6 15 / 0.85));
  }

  .world .scene:not(.scene-intro) .eyebrow {
    display: inline-block;
    padding: 0 0.5rem;
    background: var(--nebula);
    color: var(--space-0);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }
</style>
